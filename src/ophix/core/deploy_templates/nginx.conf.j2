# Ophix Server — nginx configuration for {{ portal_name }}
# Generated by: ophix-manage generate_config --nginx
#
# INSTALLATION
#   sudo cp {{ portal_name }}.nginx.conf /etc/nginx/sites-available/{{ portal_name }}.conf
#   sudo ln -s /etc/nginx/sites-available/{{ portal_name }}.conf /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# SSL CERTIFICATES
#   Update the ssl_certificate and ssl_certificate_key paths below to point to
#   your actual certificate and private key files.  If using ophix-certs or
#   CA-tools, place the files at the paths shown.

{% if http_redirect %}
# HTTP → HTTPS redirect
server {
    listen 80;
    server_name {{ server_hostname }};
    return 301 https://$host$request_uri;
}

{% endif %}
# HTTPS
server {
    listen 443 ssl;
    server_name {{ server_hostname }};

    # SSL — update these paths to your certificate files
    ssl_certificate     {{ install_dir }}/ssl/certs/{{ portal_name }}.crt;
    ssl_certificate_key {{ install_dir }}/ssl/private/{{ portal_name }}.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Logging
    access_log {{ install_dir }}/logs/{{ portal_name }}.access.log;
    error_log  {{ install_dir }}/logs/{{ portal_name }}.error.log;

    # Client IP handling
    #   Ophix authenticates fleet clients by token AND source IP, so the IP
    #   Django sees must be one the client cannot choose.  Django reads only
    #   the X-Real-IP header, which each location below sets to $remote_addr
    #   (overwriting anything the client sent).  X-Forwarded-For is also reset
    #   to $remote_addr rather than appended to, so no client-supplied value
    #   is ever passed upstream.
{%- if trusted_proxies %}
    #
    #   This server sits behind the upstream proxies listed below.  nginx's
    #   realip module replaces $remote_addr with the client address those
    #   proxies report in X-Forwarded-For, walking the chain from the right
    #   and stopping at the first address that is NOT a trusted proxy.
    #   Only list proxies you control: any address listed here can claim to
    #   be any client.  (Configured via [nginx] trusted_proxies in
    #   configure_install.)
{%- for proxy in trusted_proxies %}
    set_real_ip_from {{ proxy }};
{%- endfor %}
    real_ip_header     X-Forwarded-For;
    real_ip_recursive  on;
{%- else %}
    #
    #   No upstream proxies are trusted, so $remote_addr is the TCP peer.
    #   If you place a load balancer or reverse proxy in front of this server,
    #   do not simply trust X-Forwarded-For; re-run configure_install and
    #   set "trusted upstream proxies" to the proxy addresses/CIDRs, which
    #   adds set_real_ip_from / real_ip_header / real_ip_recursive here.
{%- endif %}

    # Custom error pages — served directly from static files
    # (503 is served even when Gunicorn is down because /static/ is a direct alias)
    error_page 400 /static/error_pages/400.html;
    error_page 403 /static/error_pages/403.html;
    error_page 404 /static/error_pages/404.html;
    error_page 500 502 /static/error_pages/500.html;
    error_page 503 504 /static/error_pages/503.html;

    # API — error responses pass through as-is (clients expect JSON, not HTML)
    location /api/ {
        proxy_pass         http://unix:{{ install_dir }}/run/{{ portal_name }}.sock;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Admin and everything else — intercept upstream errors to serve custom pages
    location / {
        proxy_pass         http://unix:{{ install_dir }}/run/{{ portal_name }}.sock;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Intercept upstream errors so the error_page directives above apply
        # to responses from Django/Gunicorn (not just nginx-generated errors).
        proxy_intercept_errors on;
    }

    # Static files (Django collectstatic output)
    location /static/ {
        alias {{ static_root }}/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Media files (uploads)
    location /media/ {
        alias {{ media_root }}/;
    }
}
