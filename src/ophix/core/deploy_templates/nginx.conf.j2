# Ophix Server — nginx configuration for {{ portal_name }}
# Generated by: ophix-manage generate_config --nginx
#
# INSTALLATION
#   sudo cp {{ portal_name }}.nginx.conf /etc/nginx/sites-available/{{ portal_name }}.conf
#   sudo ln -s /etc/nginx/sites-available/{{ portal_name }}.conf /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# SSL CERTIFICATES
#   Update the ssl_certificate and ssl_certificate_key paths below to point to
#   your actual certificate and private key files.  If using ophix-certs or
#   CA-tools, place the files at the paths shown.

{% if http_redirect %}
# HTTP → HTTPS redirect
server {
    listen 80;
    server_name {{ server_hostname }};
    return 301 https://$host$request_uri;
}

{% endif %}
# HTTPS
server {
    listen 443 ssl;
    server_name {{ server_hostname }};

    # SSL — update these paths to your certificate files
    ssl_certificate     {{ install_dir }}/ssl/certs/{{ portal_name }}.crt;
    ssl_certificate_key {{ install_dir }}/ssl/private/{{ portal_name }}.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Logging
    access_log {{ install_dir }}/logs/{{ portal_name }}.access.log;
    error_log  {{ install_dir }}/logs/{{ portal_name }}.error.log;

    # Custom error pages — served directly from static files
    # (503 is served even when Gunicorn is down because /static/ is a direct alias)
    error_page 400 /static/error_pages/400.html;
    error_page 403 /static/error_pages/403.html;
    error_page 404 /static/error_pages/404.html;
    error_page 500 502 /static/error_pages/500.html;
    error_page 503 504 /static/error_pages/503.html;

    # Proxy to Gunicorn via Unix socket
    location / {
        proxy_pass         http://unix:{{ install_dir }}/run/{{ portal_name }}.sock;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # IMPORTANT: if behind a load balancer, ensure the LB strips and re-sets
        # X-Forwarded-For before requests reach this server.  Without this,
        # clients on an internal network could spoof their source IP.
    }

    # Static files (Django collectstatic output)
    location /static/ {
        alias {{ static_root }}/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Media files (uploads)
    location /media/ {
        alias {{ media_root }}/;
    }
}
