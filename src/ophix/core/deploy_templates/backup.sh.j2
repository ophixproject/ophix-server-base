#!/usr/bin/env bash
# {{ server_name }}-backup.sh
# Generated by: ophix-manage create_backup_script
#
# Re-generate at any time to pick up venv path changes:
#   ophix-manage create_backup_script
#
# Usage:
#   {{ script_path }}              — export to dated .json files
#   {{ script_path }} --compress   — export then bundle into a single .tgz
#
# Required .env entries (file co-located with this script):
#   BACKUP_PATH=/path/to/backup/directory
#   BACKUP_TARGETS=...             # comma-separated plain export targets
#   BACKUP_TARGETS_ENCRYPTED=...   # comma-separated encrypted export targets
# See the backup docs for recommended values for your server type.
#
# Optional .env entries:
#   BACKUP_PASSPHRASE=your-passphrase       # omit to export without encryption
#   BACKUP_INCLUDE_CLIENT_LINKS=true        # include client-artifact links (default: true)
#
# Suggested cron entry (daily at 02:00):
#   0 2 * * * {{ script_path }} --compress >> /var/log/ophix-backup.log 2>&1

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"

if [[ ! -f "$ENV_FILE" ]]; then
    echo "Error: .env not found at $ENV_FILE" >&2
    exit 1
fi

# Load .env so management commands see all vars via os.environ
set -a
# shellcheck source=/dev/null
source "$ENV_FILE"
set +a

if [[ -z "${BACKUP_PATH:-}" ]]; then
    echo "Error: BACKUP_PATH is not set in $ENV_FILE" >&2
    exit 1
fi

if [[ -z "${BACKUP_TARGETS:-}" ]] && [[ -z "${BACKUP_TARGETS_ENCRYPTED:-}" ]]; then
    echo "Error: neither BACKUP_TARGETS nor BACKUP_TARGETS_ENCRYPTED is set in $ENV_FILE" >&2
    exit 1
fi

# ── Parse arguments ────────────────────────────────────────────────────────────
COMPRESS=0
for _arg in "$@"; do
    [[ "$_arg" == "--compress" ]] && COMPRESS=1
done

MANAGE="{{ manage_path }}"
DATE="$(date +%Y%m%d_%H%M%S)"

mkdir -p "$BACKUP_PATH"

# Warn early if the operator listed encrypted targets but forgot the passphrase
if [[ -n "${BACKUP_TARGETS_ENCRYPTED:-}" ]] && [[ -z "${BACKUP_PASSPHRASE:-}" ]]; then
    echo "WARNING: BACKUP_TARGETS_ENCRYPTED is set but BACKUP_PASSPHRASE is not — these exports will run without encryption" >&2
fi

# run_export <name> <use_passphrase:0|1>
#   - Skips with a warning if the command is not installed on this server
#   - Appends --passphrase-env BACKUP_PASSPHRASE when use_passphrase=1 and passphrase is set
#   - Appends --include-client-links when BACKUP_INCLUDE_CLIENT_LINKS=true (default)
#     and the command actually supports that flag (auto-detected from --help)
run_export() {
    local name=$1 use_passphrase=$2
    local cmd="export_${name}"

    local help_text
    if ! help_text=$("$MANAGE" "$cmd" --help 2>&1); then
        echo "  WARNING: $cmd not available on this server — skipped" >&2
        return
    fi

    local -a args
    args=(--output-file "$BACKUP_PATH/${name}_${DATE}.json" --quiet)

    local encrypted=0
    if [[ "$use_passphrase" -eq 1 ]] && [[ -n "${BACKUP_PASSPHRASE:-}" ]]; then
        args+=(--passphrase-env BACKUP_PASSPHRASE)
        encrypted=1
    fi

    if [[ "${BACKUP_INCLUDE_CLIENT_LINKS:-true}" == "true" ]] && \
       grep -q -- '--include-client-links' <<< "$help_text"; then
        args+=(--include-client-links)
    fi

    "$MANAGE" "$cmd" "${args[@]}"

    if [[ "$use_passphrase" -eq 1 ]]; then
        if [[ "$encrypted" -eq 1 ]]; then
            echo "  ${name}.json written [encrypted]"
        else
            echo "  ${name}.json written [unencrypted — BACKUP_PASSPHRASE not set]"
        fi
    else
        echo "  ${name}.json written"
    fi
}

echo "[$DATE] Starting backup — {{ server_name }}"

# ── Plain exports ──────────────────────────────────────────────────────────────
IFS=',' read -ra _plain <<< "${BACKUP_TARGETS:-}"
for _name in "${_plain[@]}"; do
    _name="${_name// /}"
    [[ -z "$_name" ]] && continue
    run_export "$_name" 0
done

# ── Encrypted exports ──────────────────────────────────────────────────────────
IFS=',' read -ra _encrypted <<< "${BACKUP_TARGETS_ENCRYPTED:-}"
for _name in "${_encrypted[@]}"; do
    _name="${_name// /}"
    [[ -z "$_name" ]] && continue
    run_export "$_name" 1
done

# ── Compress ───────────────────────────────────────────────────────────────────
if [[ "$COMPRESS" -eq 1 ]]; then
    shopt -s nullglob
    _json_files=("${BACKUP_PATH}"/*_${DATE}.json)
    shopt -u nullglob
    if [[ ${#_json_files[@]} -gt 0 ]]; then
        _archive="${BACKUP_PATH}/{{ server_name }}_${DATE}.tgz"
        tar -czf "$_archive" -C "$BACKUP_PATH" "${_json_files[@]##*/}"
        rm -f "${_json_files[@]}"
        echo "  Bundled to $(basename "$_archive")"
    fi
fi

echo "[$DATE] Backup complete — $BACKUP_PATH"
