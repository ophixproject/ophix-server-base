#!/usr/bin/env bash
# {{ server_name }}-update.sh
# Generated by: ophix-manage create_update_script
#
# Re-generate at any time to pick up venv path changes:
#   ophix-manage create_update_script
#
# Runs the full upgrade sequence for this server:
#   1. venv-cmds check_updates  — discover available package updates
#   2. pip install -r updates.txt  — apply them
#   3. ophix-manage apply_updates --include-docs  — migrate, collectstatic, docs
#   4. ophix-manage check_updates --quiet  — refresh plugin versions table
#   5. ophix-manage purge_docs --deleted  — remove docs for removed packages
#
# Paths are baked in at generation time. Re-run create_update_script after
# moving the venv or changing INSTALL_DIR.
#
# After this script completes, restart the service:
#   sudo systemctl restart {{ service_name }}

set -euo pipefail

INSTALL_DIR="{{ install_dir }}"
VENV="{{ venv_path }}"
MANAGE="{{ manage_path }}"
SERVICE="{{ service_name }}"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting update — {{ server_name }}"
echo ""

# Always run from the install directory so .env is found by management commands.
cd "$INSTALL_DIR"

# Activate the venv. Safe to source even if already active.
# shellcheck source=/dev/null
source "$VENV/bin/activate"

# ── Package updates ───────────────────────────────────────────────────────────
echo "=== Checking for package updates ==="
_updates_file="$INSTALL_DIR/.updates.txt"
if command -v venv-cmds &>/dev/null; then
    venv-cmds check_updates -o "$_updates_file"
    if [[ -s "$_updates_file" ]]; then
        echo "Installing updates..."
        pip install -r "$_updates_file"
    else
        echo "No updates available."
    fi
    rm -f "$_updates_file"
else
    echo "WARNING: venv-cmds not found — skipping package update step." >&2
    echo "         Install with: pip install venv-cmds" >&2
fi
echo ""

# ── Django post-upgrade steps ─────────────────────────────────────────────────
echo "=== Applying Django updates ==="
"$MANAGE" apply_updates --include-docs
echo ""

# ── Refresh plugin versions table ─────────────────────────────────────────────
echo "=== Refreshing plugin versions ==="
"$MANAGE" check_updates --quiet
echo ""

# ── Purge docs for removed packages ──────────────────────────────────────────
if "$MANAGE" purge_docs --help &>/dev/null; then
    echo "=== Purging deleted docs ==="
    "$MANAGE" purge_docs --deleted
    echo ""
fi

deactivate

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Update complete — {{ server_name }}"
echo ""
echo "Restart the service to activate changes:"
echo "  sudo systemctl restart $SERVICE"
