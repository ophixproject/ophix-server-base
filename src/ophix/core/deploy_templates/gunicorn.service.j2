# Ophix Server — systemd service for {{ portal_name }}
# Generated by: ophix-manage generate_config --systemd
#
# INSTALLATION
#   sudo cp {{ portal_name }}.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable {{ portal_name }}
#   sudo systemctl start {{ portal_name }}
#
# USEFUL COMMANDS
#   sudo systemctl status {{ portal_name }}
#   sudo journalctl -u {{ portal_name }} -f
#   sudo systemctl restart {{ portal_name }}

[Unit]
Description=Gunicorn daemon for {{ description }}
After=network.target

[Service]
User={{ service_user }}
Group={{ service_group }}

# Working directory must contain (or be a parent of) the .env file
WorkingDirectory={{ install_dir }}

# Django settings are set explicitly so gunicorn doesn't rely on manage.py
Environment=DJANGO_SETTINGS_MODULE=ophix.settings

ExecStart={{ venv_path }}/bin/gunicorn \
    --workers 3 \
    --bind unix:{{ install_dir }}/run/{{ portal_name }}.sock \
    --access-logfile {{ install_dir }}/logs/{{ portal_name }}.gunicorn.access.log \
    --error-logfile  {{ install_dir }}/logs/{{ portal_name }}.gunicorn.error.log \
    ophix.wsgi:application

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
