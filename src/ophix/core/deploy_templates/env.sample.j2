# Ophix Server — environment configuration
# Generated by: ophix-manage configure_install {{ server_name }}
#
# This file is managed by configure_install / run_install.
# To reconfigure: ophix-manage configure_install {{ server_name }}
# To add new plugin settings: ophix-manage generate_ophix_config --append

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Leave blank — a secret key is auto-generated on first run and saved here.
DJANGO_SECRET_KEY=

# Set to True only during development. NEVER in production.
DEBUG=False

# Comma-separated list of hostnames/IPs this server will respond to.
# Example: ALLOWED_HOSTS=credserver.example.com,127.0.0.1
# Use * during initial setup only; tighten before going to production.
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------

# Short name for this server instance — shown in the admin footer as
# SERVER_NAME-SERVER_VERSION (e.g. certserver-2026.04.12.01).
# The installed domain plugin sets a default (certserver, credserver, etc.).
# Override here to customise for a specific deployment.
SERVER_NAME={{ server_name }}

# Systemd service name for this server — written automatically by run_install.
# Used by apply_updates to print the correct restart command. Only needs to be
# set manually when the service name differs from SERVER_NAME (e.g. the slug
# passed to configure_install was different from the SERVER_NAME value).
# SERVICE_NAME={{ server_name }}

# Version string — auto-populated from the installed domain plugin by
# generate_ophix_config. Re-run with --append after upgrading to pick up
# the new version.
SERVER_VERSION={{ domain_version }}

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Root directory for runtime data: media files, logs, socket, SSL certs.
# Must exist and be writable by the service user before starting the server.
# Create with: sudo mkdir -p {{ install_dir }}/{logs,media,run,ssl/certs,ssl/private}
INSTALL_DIR={{ install_dir }}

# Override the media files root if needed (default: INSTALL_DIR/media).
# DJANGO_MEDIA_ROOT=

# Path to the CA certificate served to new clients via GET /api/server/ca-cert/
# Set automatically by run_install when a CA bundle is provided during configure_install.
CA_CERT_FILE=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_ENGINE: mariadb (default) | mysql | postgres | sqlserver | oracle | cockroachdb
# Install the matching plugin for non-default engines:
#   ophix-dbengine-postgres     pip install ophix-dbengine-postgres
#   ophix-dbengine-mssql        pip install ophix-dbengine-mssql  (+ ODBC Driver 17/18)
#   ophix-dbengine-oracle       pip install ophix-dbengine-oracle
#   ophix-dbengine-cockroachdb  pip install ophix-dbengine-cockroachdb
# Use: ophix-manage configure_database  to set these interactively with a live
# connection test before writing.

DB_ENGINE=mariadb
DB_NAME=ophix_db
DB_USER=ophixuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# TLS — all optional. Set DB_SSL_CA to enable TLS for the database connection.
# DB_SSL_CERT and DB_SSL_KEY are only needed for mutual TLS (client certificate
# authentication). Leave all three blank for an unencrypted connection.
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# ---------------------------------------------------------------------------
# Localisation
# ---------------------------------------------------------------------------

# UTC is strongly recommended for server deployments and works out of the box.
# If you set a non-UTC timezone and are using MariaDB or MySQL, the timezone
# tables must be populated in the database before the Access Logs admin view
# will work correctly. See the server installation docs for the one-time command.
TIME_ZONE=UTC
LANGUAGE_CODE=en-au

# ---------------------------------------------------------------------------
# Admin UI visibility flags
# All default to False. Enable in .env as required.
# ---------------------------------------------------------------------------

# Show the Django Themes model (django-admin-interface branding).
SHOW_THEME_MODEL=False

# Show Django's built-in Users and Groups models.
SHOW_AUTH_MODELS=False

# Show the raw client-artifact join model (useful for debugging).
SHOW_CLIENT_ARTIFACT_MODEL=False

# Show the Access Logs model (audit trail of client artifact access).
SHOW_ACCESS_LOGS=True

# Retention period for access log records pruned by: ophix-manage prune_access_log
# PRUNE_ACCESS_LOG_DAYS=90

# Show the Plugin Versions model (populated by: ophix-manage check_updates).
SHOW_PLUGIN_VERSION_MODEL=False

# Show the IPv6 Address column on the Hosts list. Set to False on IPv4-only networks.
SHOW_IPV6_ADDRESS=True

# Display version string and copyright in the admin footer.
DISPLAY_VERSION_FOOTER=True
DISPLAY_COPYRIGHT=True

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------

# Include error detail in API responses. Development only — False in production.
# When False, all auth failures return the same generic message (no fingerprinting).
AUTH_LEAK_INFO=False

# Minimum seconds between token rotations. Default: 3600 (1 hour).
MINIMUM_TOKEN_ROTATE_TIME=3600

# Allow clients to delete their own artifacts. Disabled by default.
ENABLE_ARTIFACT_DELETE=False

# ---------------------------------------------------------------------------
# Authentication plugins
# ---------------------------------------------------------------------------
# SSO and LDAP settings are contributed by their respective plugins.
# Install the plugin, then re-run generate_ophix_config --append to add
# the relevant settings block to this file.
#
#   pip install ophix-auth-oidc    (OpenID Connect / Azure AD)
#   pip install ophix-auth-ldap    (Active Directory / LDAP bind)
# ---------------------------------------------------------------------------
