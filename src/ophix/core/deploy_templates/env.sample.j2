# Ophix Server — environment configuration
# Generated by: ophix-manage generate_deploy_config --env
#
# SETUP
#   cp .env.sample .env
#   chmod 600 .env          <-- important: this file will contain secrets
#   Edit .env for your environment, then run:
#     ophix-manage configure_database   (interactive DB setup + connection test)
#     ophix-manage migrate
#     ophix-manage collectstatic --noinput
#     ophix-manage createsuperuser

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Leave blank — a secret key is auto-generated on first run and saved here.
DJANGO_SECRET_KEY=

# Set to True only during development. NEVER in production.
DEBUG=False

# Comma-separated list of hostnames/IPs this server will respond to.
# Example: ALLOWED_HOSTS=credserver.example.com,127.0.0.1
# Use * during initial setup only; tighten before going to production.
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------

# Short name for this server instance — shown in the admin footer as
# SERVER_NAME-SERVER_VERSION (e.g. certserver-2026.04.12.01).
# The installed domain plugin sets a default (certserver, credserver, etc.).
# Override here to customise for a specific deployment.
SERVER_NAME={{ server_name }}

# Version string — auto-populated from the installed domain plugin by
# generate_deploy_config. Re-run with --append after upgrading to pick up
# the new version.
SERVER_VERSION={{ domain_version }}

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Root directory for runtime data: media files, logs, socket, SSL certs.
# Must exist and be writable by the service user before starting the server.
# Create with: sudo mkdir -p {{ install_dir }}/{logs,media,run,ssl/certs,ssl/private}
INSTALL_DIR={{ install_dir }}

# Override the media files root if needed (default: INSTALL_DIR/media).
# DJANGO_MEDIA_ROOT=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_ENGINE: mariadb (default) | mysql | postgres
# Use: ophix-manage configure_database  to set these interactively with a
# live connection test before writing.
# Install the matching driver: pip install ophix-server-base[mariadb|mysql|postgres]

# DB_ENGINE=mariadb

DB_NAME=ophix_db
DB_USER=ophixuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# TLS — all optional. Set DB_SSL_CA to enable TLS for the database connection.
# DB_SSL_CERT and DB_SSL_KEY are only needed for mutual TLS (client certificate
# authentication). Leave all three blank for an unencrypted connection.
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem

# ---------------------------------------------------------------------------
# Localisation
# ---------------------------------------------------------------------------

TIME_ZONE=UTC
LANGUAGE_CODE=en-au

# ---------------------------------------------------------------------------
# Admin UI visibility flags
# All default to False. Enable in .env as required.
# ---------------------------------------------------------------------------

# Show the Django Themes model (django-admin-interface branding).
SHOW_THEME_MODEL=False

# Show Django's built-in Users and Groups models.
SHOW_AUTH_MODELS=False

# Show the raw client-artifact join model (useful for debugging).
SHOW_CLIENT_ARTIFACT_MODEL=False

# Show the Access Logs model (audit trail of client artifact access).
SHOW_ACCESS_LOGS=False

# Display version string and copyright in the admin footer.
DISPLAY_VERSION_FOOTER=False
DISPLAY_COPYRIGHT=False

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------

# Include error detail in API responses. Development only — False in production.
# When False, all auth failures return the same generic message (no fingerprinting).
AUTH_LEAK_INFO=False

# Minimum seconds between token rotations. Default: 3600 (1 hour).
MINIMUM_TOKEN_ROTATE_TIME=3600

# Allow clients to delete their own artifacts. Disabled by default.
ENABLE_ARTIFACT_DELETE=False

# ---------------------------------------------------------------------------
# SSO — OpenID Connect (optional)
# Requires: pip install ophix-server-base[sso]
#
# SSO is activated when OIDC_RP_CLIENT_ID is set. Leave blank to use the
# standard Django username/password login.
#
# Azure AD shortcut: set OIDC_AZURE_TENANT_ID and the four OIDC endpoint
# URLs are derived automatically. For other providers, set each URL directly.
# ---------------------------------------------------------------------------

# Application (client) ID registered in your IdP.
# OIDC_RP_CLIENT_ID=

# Client secret for the application registration.
# OIDC_RP_CLIENT_SECRET=

# Azure AD tenant ID — shortcut that auto-derives all four endpoint URLs.
# OIDC_AZURE_TENANT_ID=

# Token signing algorithm (default: RS256). Change to RS384 / RS512 if
# required by your IdP.
# OIDC_RP_SIGN_ALGO=RS256

# Scopes to request. Default covers the common claims.
# For Azure AD group claims, no extra scope is needed — groups appear in the
# ID token when the app registration is configured to emit them.
# OIDC_RP_SCOPES=openid profile email

# For non-Azure providers set each endpoint URL individually:
# OIDC_OP_AUTHORIZATION_ENDPOINT=
# OIDC_OP_TOKEN_ENDPOINT=
# OIDC_OP_USER_ENDPOINT=
# OIDC_OP_JWKS_ENDPOINT=

# Group IDs from the IdP that map to Django staff / superuser status.
# Use the object ID (GUID) of the group in Azure AD, or the group name/ID
# used by your IdP. If neither is set, all SSO users are granted staff access.
# OIDC_STAFF_GROUP_ID=
# OIDC_SUPERUSER_GROUP_ID=

# How often (seconds) the session refresh middleware re-validates the token.
# Default: 900 (15 minutes).
# OIDC_RENEW_ID_TOKEN_EXPIRY_SECONDS=900
