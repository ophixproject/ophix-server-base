# Ophix Server — environment configuration
# Generated by: ophix-manage generate_deploy_config --env
#
# SETUP
#   cp .env.sample .env
#   chmod 600 .env          <-- important: this file will contain secrets
#   Edit .env for your environment, then run:
#     ophix-manage configure_database   (interactive DB setup + connection test)
#     ophix-manage migrate
#     ophix-manage collectstatic --noinput
#     ophix-manage createsuperuser

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Leave blank — a secret key is auto-generated on first run and saved here.
DJANGO_SECRET_KEY=

# Set to True only during development. NEVER in production.
DEBUG=False

# Comma-separated list of hostnames/IPs this server will respond to.
# Example: ALLOWED_HOSTS=credserver.example.com,127.0.0.1
# Use * during initial setup only; tighten before going to production.
ALLOWED_HOSTS=*

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------

# Human-readable name shown in the admin header and footer.
SERVER_NAME={{ server_name }}

# Machine-readable version string — set by release tooling, or leave blank.
SERVER_VERSION=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Root directory for runtime data: media files, logs, socket, SSL certs.
# Must exist and be writable by the service user before starting the server.
# Create with: sudo mkdir -p {{ install_dir }}/{logs,media,run,ssl/certs,ssl/private}
INSTALL_DIR={{ install_dir }}

# Override the media files root if needed (default: INSTALL_DIR/media).
# DJANGO_MEDIA_ROOT=

# ---------------------------------------------------------------------------
# Database — MariaDB
# ---------------------------------------------------------------------------
# Use: ophix-manage configure_database  to set these interactively with a
# live connection test before writing.

DB_NAME=ophix_db
DB_USER=ophixuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---------------------------------------------------------------------------
# Localisation
# ---------------------------------------------------------------------------

TIME_ZONE=UTC
LANGUAGE_CODE=en-au

# ---------------------------------------------------------------------------
# Admin UI visibility flags
# All default to False. Enable in .env as required.
# ---------------------------------------------------------------------------

# Show the Django Themes model (django-admin-interface branding).
SHOW_THEME_MODEL=False

# Show Django's built-in Users and Groups models.
SHOW_AUTH_MODELS=False

# Show the raw client-artifact join model (useful for debugging).
SHOW_CLIENT_ARTIFACT_MODEL=False

# Show the Access Logs model (audit trail of client artifact access).
SHOW_ACCESS_LOGS=False

# Display version string and copyright in the admin footer.
DISPLAY_VERSION_FOOTER=False
DISPLAY_COPYRIGHT=False

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------

# Include error detail in API responses. Development only — False in production.
# When False, all auth failures return the same generic message (no fingerprinting).
AUTH_LEAK_INFO=False

# Minimum seconds between token rotations. Default: 3600 (1 hour).
MINIMUM_TOKEN_ROTATE_TIME=3600

# Allow clients to delete their own artifacts. Disabled by default.
ENABLE_ARTIFACT_DELETE=False
