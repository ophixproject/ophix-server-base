# ===========================================================================
# Ophix Project Server — sample environment configuration
# Copy to .env and edit for your deployment.
# ===========================================================================

# ---------------------------------------------------------------------------
# Server identity
# ---------------------------------------------------------------------------
SERVER_NAME=Ophix Server
SERVER_VERSION=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# DJANGO_SECRET_KEY is auto-generated on first run and written back here.
# You may set it explicitly for reproducible deployments.
#DJANGO_SECRET_KEY=

DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Database (MariaDB)
# ---------------------------------------------------------------------------
DB_NAME=ophix_db
DB_USER=ophixuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Root of the installation — persistent data (media, fixtures) lives here.
INSTALL_DIR=/home/websites/ophix

# Optional: override media root explicitly.
#DJANGO_MEDIA_ROOT=/home/websites/ophix/media

# Path to the internal CA certificate file served at /api/server/ca-cert/
#CA_CERT_FILE=/path/to/ca-cert.pem

# ---------------------------------------------------------------------------
# Internationalisation
# ---------------------------------------------------------------------------
LANGUAGE_CODE=en-au
TIME_ZONE=Australia/Melbourne

# ---------------------------------------------------------------------------
# Ophix API behaviour
# ---------------------------------------------------------------------------
# Set true in development to get descriptive error messages from the API.
# Must be false in production — leaks internal state.
AUTH_LEAK_INFO=false

# Minimum seconds between token rotations (default: 3600 = 1 hour).
MINIMUM_TOKEN_ROTATE_TIME=3600

# Allow clients to delete artifacts they own (default: false).
ENABLE_ARTIFACT_DELETE=false

# ---------------------------------------------------------------------------
# Plugin control
# ---------------------------------------------------------------------------
# Comma-separated list of plugin module names to suppress even if installed.
# Example: OPHIX_DISABLE=ophix_docs,ophix_language_fr
#OPHIX_DISABLE=

# ---------------------------------------------------------------------------
# Admin UI
# ---------------------------------------------------------------------------
DISPLAY_VERSION_FOOTER=false
DISPLAY_COPYRIGHT=true
ADMIN_THEME_EDITABLE=false
SHOW_AUTH_MODELS=false
SHOW_CLIENT_ARTIFACT_MODEL=false

# ---------------------------------------------------------------------------
# ophix-docs (if installed)
# ---------------------------------------------------------------------------
OPHIX_DOCS_ENABLED=true
#OPHIX_DOCS_PATH=
OPHIX_DOCS_APP_LABEL=Documentation
